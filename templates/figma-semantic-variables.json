{
  "_meta": {
    "collectionName": "axpublish / Semantic",
    "mode": "Light",
    "description": "axpublish Figma Variable Collection 템플릿. MCP Write 시 이 구조대로 생성.",
    "themeOverride": ["Primary", "Secondary"],
    "totalVariables": 52,
    "notes": [
      "Primary / Secondary는 generate-theme.js 결과(theme.css)로 덮어씀",
      "나머지는 Seed Design 기본값 그대로 사용",
      "alpha < 1 인 경우 반드시 alpha 값 별도 설정 (Figma opacity 바인딩)",
      "변수명 규칙: Title Case, Slash 구분 (예: Label/Normal)",
      "Point/Text, Point/Brand, Background/Section은 이롬넷 레퍼런스 파일 실측으로 신규 추가됨 (기존 49개 → 52개)"
    ]
  },

  "Primary": {
    "_source": "theme.css",
    "_note": "generate-theme.js 실행 결과로 덮어씀. 기본값은 Seed Blue.",
    "Normal":  { "hex": "#0066FF", "alpha": 1.00, "css": "--color-primary-normal" },
    "Strong":  { "hex": "#005EEB", "alpha": 1.00, "css": "--color-primary-strong" },
    "Heavy":   { "hex": "#0054D1", "alpha": 1.00, "css": "--color-primary-heavy"  }
  },

  "Point": {
    "_source": "theme.css",
    "_note": "Primary와 동일 값을 참조하는 alias. 텍스트 강조(Text)와 브랜드 자산(Brand)을 의미상 분리해서 쓰기 위함. Primary가 override되면 자동으로 같이 갱신됨. (이롬넷 레퍼런스에서 실사용 확인)",
    "Text":  { "hex": "{{primary-50}}", "alpha": 1.00, "css": "--color-text-point"    },
    "Brand": { "hex": "{{primary-50}}", "alpha": 1.00, "css": "--color-brand-primary" }
  },

  "Secondary": {
    "_source": "theme.css",
    "_note": "generate-theme.js 실행 결과로 채워짐. 기본값 없음.",
    "Normal":  { "hex": "{{secondary-50}}", "alpha": 1.00, "css": "--color-secondary-normal" },
    "Strong":  { "hex": "{{secondary-45}}", "alpha": 1.00, "css": "--color-secondary-strong" },
    "Heavy":   { "hex": "{{secondary-40}}", "alpha": 1.00, "css": "--color-secondary-heavy"  }
  },

  "Label": {
    "_source": "tokens.css",
    "Strong":      { "hex": "#000000", "alpha": 1.00, "css": "--color-label-strong"      },
    "Normal":      { "hex": "#171719", "alpha": 1.00, "css": "--color-label-normal"      },
    "Neutral":     { "hex": "#2E2F33", "alpha": 0.88, "css": "--color-label-neutral"     },
    "Alternative": { "hex": "#37383C", "alpha": 0.61, "css": "--color-label-alternative" },
    "Assistive":   { "hex": "#37383C", "alpha": 0.28, "css": "--color-label-assistive"   },
    "Disable":     { "hex": "#37383C", "alpha": 0.16, "css": "--color-label-disable"     }
  },

  "Background": {
    "_source": "tokens.css",
    "Normal": {
      "Normal":      { "hex": "#FFFFFF", "alpha": 1.00, "css": "--color-bg-normal"        },
      "Alternative": { "hex": "#F7F7F8", "alpha": 1.00, "css": "--color-bg-normal-alt"    },
      "Section":     { "hex": "#EAEBEC", "alpha": 1.00, "css": "--color-bg-section", "_note": "신규 — 섹션 구분용 3단계 배경(Base/Cool Neutral/97). Normal-alt보다 한 단계 더 진함. 이롬넷 레퍼런스에서 발견" }
    },
    "Elevated": {
      "Normal":      { "hex": "#FFFFFF", "alpha": 1.00, "css": "--color-bg-elevated"      },
      "Alternative": { "hex": "#F7F7F8", "alpha": 1.00, "css": "--color-bg-elevated-alt"  }
    },
    "Transparent": {
      "Normal":      { "hex": "#FFFFFF", "alpha": 0.08, "css": "--color-bg-trans-normal"  },
      "Alternative": { "hex": "#FFFFFF", "alpha": 0.28, "css": "--color-bg-trans-alt"     }
    }
  },

  "Interaction": {
    "_source": "tokens.css",
    "Inactive": { "hex": "#989BA2", "alpha": 1.00, "css": "--color-interaction-inactive" },
    "Disable":  { "hex": "#F4F4F5", "alpha": 1.00, "css": "--color-interaction-disable"  }
  },

  "Line": {
    "_source": "tokens.css",
    "_note": "Normal = rgba 반투명 (겹침 허용) / Solid = 불투명",
    "Normal": {
      "Normal":      { "hex": "#70737C", "alpha": 0.22, "css": "--color-line-normal"       },
      "Neutral":     { "hex": "#70737C", "alpha": 0.16, "css": "--color-line-normal-n"     },
      "Alternative": { "hex": "#70737C", "alpha": 0.08, "css": "--color-line-normal-alt"   },
      "Strong":      { "hex": "#70737C", "alpha": 0.52, "css": "--color-line-normal-s"     }
    },
    "Solid": {
      "Normal":      { "hex": "#E1E2E4", "alpha": 1.00, "css": "--color-line-solid"        },
      "Neutral":     { "hex": "#EAEBEC", "alpha": 1.00, "css": "--color-line-solid-n"      },
      "Alternative": { "hex": "#F4F4F5", "alpha": 1.00, "css": "--color-line-solid-alt"    },
      "Strong":      { "hex": "#212225", "alpha": 1.00, "css": "--color-line-solid-s", "_note": "이롬넷 레퍼런스 실측값으로 갱신 (기존 #AEB0B6보다 훨씬 진함)" }
    }
  },

  "Fill": {
    "_source": "tokens.css",
    "_note": "hover 배경, 서브틀한 오버레이 배경",
    "Normal":      { "hex": "#70737C", "alpha": 0.08, "css": "--color-fill-normal" },
    "Strong":      { "hex": "#70737C", "alpha": 0.16, "css": "--color-fill-strong" },
    "Alternative": { "hex": "#70737C", "alpha": 0.05, "css": "--color-fill-alt"    }
  },

  "Status": {
    "_source": "tokens.css",
    "Positive":   { "hex": "#00BF40", "alpha": 1.00, "css": "--color-status-positive"   },
    "Cautionary": { "hex": "#FF9200", "alpha": 1.00, "css": "--color-status-cautionary" },
    "Negative":   { "hex": "#FF4242", "alpha": 1.00, "css": "--color-status-negative"   }
  },

  "Static": {
    "_source": "tokens.css",
    "_note": "모드(light/dark) 무관 절대 고정값",
    "White": { "hex": "#FFFFFF", "alpha": 1.00, "css": "--color-static-white" },
    "Black": { "hex": "#000000", "alpha": 1.00, "css": "--color-static-black" }
  },

  "Material": {
    "_source": "tokens.css",
    "Dimmer": { "hex": "#171719", "alpha": 0.52, "css": "--color-material-dimmer" }
  },

  "Inverse": {
    "_source": "tokens.css",
    "_note": "다크 배경(inverse-background) 위에 얹히는 요소용",
    "Primary":    { "hex": "#3385FF", "alpha": 1.00, "css": "--color-inverse-primary"    },
    "Background": { "hex": "#333438", "alpha": 1.00, "css": "--color-inverse-background", "_note": "이롬넷 레퍼런스 실측값으로 갱신 (기존 #1B1C1E에서 변경)" },
    "Label":      { "hex": "#F7F7F8", "alpha": 1.00, "css": "--color-inverse-label"      }
  },

  "Accent": {
    "_source": "tokens.css",
    "Background": {
      "_note": "장식용 배경 컬러. 가독성 높은 텍스트는 Foreground 페어 사용",
      "Red Orange": { "hex": "#FF5E00", "alpha": 1.00, "css": "--color-accent-bg-redorange" },
      "Lime":       { "hex": "#58CF04", "alpha": 1.00, "css": "--color-accent-bg-lime"      },
      "Cyan":       { "hex": "#00BDDE", "alpha": 1.00, "css": "--color-accent-bg-cyan"      },
      "Light Blue": { "hex": "#00AEFF", "alpha": 1.00, "css": "--color-accent-bg-lightblue" },
      "Violet":     { "hex": "#6541F2", "alpha": 1.00, "css": "--color-accent-bg-violet"    },
      "Purple":     { "hex": "#CB59FF", "alpha": 1.00, "css": "--color-accent-bg-purple"    },
      "Pink":       { "hex": "#F553DA", "alpha": 1.00, "css": "--color-accent-bg-pink"      }
    },
    "Foreground": {
      "_note": "텍스트/아이콘 강조용 컬러. 대비 확보를 위해 Atomic shade 40 기준",
      "Red":        { "hex": "#E52222", "alpha": 1.00, "css": "--color-accent-fg-red"       },
      "Red Orange": { "hex": "#F55A00", "alpha": 1.00, "css": "--color-accent-fg-redorange" },
      "Orange":     { "hex": "#D17600", "alpha": 1.00, "css": "--color-accent-fg-orange"    },
      "Lime":       { "hex": "#429E00", "alpha": 1.00, "css": "--color-accent-fg-lime"      },
      "Green":      { "hex": "#009632", "alpha": 1.00, "css": "--color-accent-fg-green"     },
      "Cyan":       { "hex": "#0098B2", "alpha": 1.00, "css": "--color-accent-fg-cyan"      },
      "Light Blue": { "hex": "#008DCF", "alpha": 1.00, "css": "--color-accent-fg-lightblue" },
      "Blue":       { "hex": "#005EEB", "alpha": 1.00, "css": "--color-accent-fg-blue"      },
      "Violet":     { "hex": "#5B37ED", "alpha": 1.00, "css": "--color-accent-fg-violet"    },
      "Purple":     { "hex": "#AD36E3", "alpha": 1.00, "css": "--color-accent-fg-purple"    },
      "Pink":       { "hex": "#E846CD", "alpha": 1.00, "css": "--color-accent-fg-pink"      }
    }
  }
}
