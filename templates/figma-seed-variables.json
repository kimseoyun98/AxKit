{
  "_meta": {
    "collectionName": "axpublish / Seed",
    "modes": ["Light", "Dark"],
    "description": "axpublish v2.0 Figma Variable Collection 템플릿. Seed Design 토큰 구조 기반. MCP Write 시 이 구조대로 생성.",
    "version": "2.0.0",
    "cssPackage": "@seed-design/css",
    "brandOverride": "palette/carrot-* → generate-seed-brand.js 결과로 채움",
    "notes": [
      "palette/* 는 Primitive — Semantic이 alias로 참조",
      "fg/*, bg-*/* , stroke/* 는 Semantic — 컴포넌트에서 직접 사용",
      "Light / Dark 두 모드 모두 설정 필요 (다크모드 자동 전환)",
      "변수명 규칙: category/role[-variant] (kebab-case, slash 구분)",
      "CSS 변수: --seed-color-{category}-{role}[-{variant}]"
    ]
  },

  "palette": {
    "_note": "Primitive — 직접 사용 금지. Semantic 토큰이 alias로 참조.",

    "carrot": {
      "_note": "브랜드 컬러 (generate-seed-brand.js 결과로 override)",
      "carrot-100": { "Light": "#EBF2FF", "Dark": "#0D1A33", "css": "--seed-color-palette-carrot-100" },
      "carrot-200": { "Light": "#C7DCFF", "Dark": "#0D2966", "css": "--seed-color-palette-carrot-200" },
      "carrot-300": { "Light": "#99BFFF", "Dark": "#0F3D99", "css": "--seed-color-palette-carrot-300" },
      "carrot-400": { "Light": "#5C99FF", "Dark": "#1A5CE6", "css": "--seed-color-palette-carrot-400" },
      "carrot-500": { "Light": "#3385FF", "Dark": "#3385FF", "css": "--seed-color-palette-carrot-500" },
      "carrot-600": { "Light": "#0066FF", "Dark": "#5599FF", "css": "--seed-color-palette-carrot-600" },
      "carrot-700": { "Light": "#005EEB", "Dark": "#4080FF", "css": "--seed-color-palette-carrot-700" },
      "carrot-800": { "Light": "#0054D1", "Dark": "#2966E6", "css": "--seed-color-palette-carrot-800" },
      "carrot-900": { "Light": "#004AB8", "Dark": "#1A4DCC", "css": "--seed-color-palette-carrot-900" }
    },

    "gray": {
      "_note": "Neutral 팔레트",
      "gray-00":   { "Light": "#FFFFFF", "Dark": "#1C1C1C", "css": "--seed-color-palette-gray-00" },
      "gray-100":  { "Light": "#F5F5F5", "Dark": "#242424", "css": "--seed-color-palette-gray-100" },
      "gray-200":  { "Light": "#EBEBEB", "Dark": "#2E2E2E", "css": "--seed-color-palette-gray-200" },
      "gray-300":  { "Light": "#D9D9D9", "Dark": "#3D3D3D", "css": "--seed-color-palette-gray-300" },
      "gray-400":  { "Light": "#C2C2C2", "Dark": "#525252", "css": "--seed-color-palette-gray-400" },
      "gray-500":  { "Light": "#9E9E9E", "Dark": "#737373", "css": "--seed-color-palette-gray-500" },
      "gray-600":  { "Light": "#757575", "Dark": "#8F8F8F", "css": "--seed-color-palette-gray-600" },
      "gray-700":  { "Light": "#616161", "Dark": "#A3A3A3", "css": "--seed-color-palette-gray-700" },
      "gray-800":  { "Light": "#424242", "Dark": "#C2C2C2", "css": "--seed-color-palette-gray-800" },
      "gray-900":  { "Light": "#212121", "Dark": "#E0E0E0", "css": "--seed-color-palette-gray-900" },
      "gray-1000": { "Light": "#121212", "Dark": "#FAFAFA", "css": "--seed-color-palette-gray-1000" }
    },

    "status": {
      "green-700":  { "Light": "#388E3C", "Dark": "#4CAF50", "css": "--seed-color-palette-green-700" },
      "red-700":    { "Light": "#C62828", "Dark": "#EF5350", "css": "--seed-color-palette-red-700" },
      "yellow-700": { "Light": "#F57F17", "Dark": "#FFC107", "css": "--seed-color-palette-yellow-700" },
      "blue-700":   { "Light": "#1565C0", "Dark": "#42A5F5", "css": "--seed-color-palette-blue-700" }
    }
  },

  "fg": {
    "_note": "Foreground — 텍스트·아이콘 색상. CSS: --seed-color-fg-*",

    "neutral":          { "Light": { "alias": "palette/gray-1000" }, "Dark": { "alias": "palette/gray-1000" }, "css": "--seed-color-fg-neutral",          "usage": "기본 텍스트" },
    "neutral-muted":    { "Light": { "alias": "palette/gray-800"  }, "Dark": { "alias": "palette/gray-800"  }, "css": "--seed-color-fg-neutral-muted",    "usage": "보조 텍스트" },
    "neutral-subtle":   { "Light": { "alias": "palette/gray-700"  }, "Dark": { "alias": "palette/gray-700"  }, "css": "--seed-color-fg-neutral-subtle",   "usage": "힌트 텍스트" },
    "neutral-inverted": { "Light": { "alias": "palette/gray-00"   }, "Dark": { "alias": "palette/gray-1000" }, "css": "--seed-color-fg-neutral-inverted", "usage": "다크 배경 위 텍스트" },
    "brand":            { "Light": { "alias": "palette/carrot-600" }, "Dark": { "alias": "palette/carrot-500" }, "css": "--seed-color-fg-brand",          "usage": "브랜드 텍스트·링크" },
    "disabled":         { "Light": { "alias": "palette/gray-500"  }, "Dark": { "alias": "palette/gray-500"  }, "css": "--seed-color-fg-disabled",         "usage": "비활성 텍스트" },
    "placeholder":      { "Light": { "alias": "palette/gray-600"  }, "Dark": { "alias": "palette/gray-600"  }, "css": "--seed-color-fg-placeholder",      "usage": "플레이스홀더" },
    "positive":         { "Light": { "alias": "palette/green-700" }, "Dark": { "alias": "palette/green-700" }, "css": "--seed-color-fg-positive",         "usage": "성공 메시지" },
    "critical":         { "Light": { "alias": "palette/red-700"   }, "Dark": { "alias": "palette/red-700"   }, "css": "--seed-color-fg-critical",         "usage": "에러 메시지" },
    "warning":          { "Light": { "alias": "palette/yellow-700"}, "Dark": { "alias": "palette/yellow-700"}, "css": "--seed-color-fg-warning",          "usage": "경고 메시지" },
    "informative":      { "Light": { "alias": "palette/blue-700"  }, "Dark": { "alias": "palette/blue-700"  }, "css": "--seed-color-fg-informative",      "usage": "정보 메시지" }
  },

  "bg-layer": {
    "_note": "Background Layer — 화면 레이어 배경. CSS: --seed-color-bg-layer-*",

    "default":          { "Light": { "alias": "palette/gray-00"  }, "Dark": "#1C1C1C", "css": "--seed-color-bg-layer-default",  "usage": "기본 화면 배경" },
    "fill":             { "Light": { "alias": "palette/gray-100" }, "Dark": "#242424", "css": "--seed-color-bg-layer-fill",     "usage": "섹션 배경" },
    "floating":         { "Light": { "alias": "palette/gray-00"  }, "Dark": "#2A2A2A", "css": "--seed-color-bg-layer-floating", "usage": "카드·모달 배경" },
    "basement":         { "Light": { "alias": "palette/gray-200" }, "Dark": "#141414", "css": "--seed-color-bg-layer-basement", "usage": "앱 외곽 배경" }
  },

  "bg-brand": {
    "_note": "Background Brand — 브랜드 CTA 배경. CSS: --seed-color-bg-brand-*",

    "solid":         { "Light": { "alias": "palette/carrot-600" }, "Dark": { "alias": "palette/carrot-500" }, "css": "--seed-color-bg-brand-solid",         "usage": "Primary 버튼 배경" },
    "solid-pressed": { "Light": { "alias": "palette/carrot-700" }, "Dark": { "alias": "palette/carrot-600" }, "css": "--seed-color-bg-brand-solid-pressed", "usage": "버튼 Hover/Pressed" },
    "weak":          { "Light": { "alias": "palette/carrot-100" }, "Dark": { "alias": "palette/carrot-200" }, "css": "--seed-color-bg-brand-weak",           "usage": "연한 브랜드 배경" },
    "weak-pressed":  { "Light": { "alias": "palette/carrot-200" }, "Dark": { "alias": "palette/carrot-300" }, "css": "--seed-color-bg-brand-weak-pressed",   "usage": "연한 브랜드 Hover" }
  },

  "bg-neutral": {
    "_note": "Background Neutral — 중성 배경. CSS: --seed-color-bg-neutral-*",

    "inverted":      { "Light": { "alias": "palette/gray-900"  }, "Dark": { "alias": "palette/gray-100"  }, "css": "--seed-color-bg-neutral-inverted",      "usage": "반전 배경 (다크 버튼 등)" },
    "solid":         { "Light": { "alias": "palette/gray-1000" }, "Dark": { "alias": "palette/gray-00"   }, "css": "--seed-color-bg-neutral-solid",          "usage": "강한 중성 배경" },
    "weak":          { "Light": { "alias": "palette/gray-200"  }, "Dark": { "alias": "palette/gray-800"  }, "css": "--seed-color-bg-neutral-weak",           "usage": "약한 중성 배경" },
    "disabled":      { "Light": { "alias": "palette/gray-200"  }, "Dark": "#2E2E2E",                        "css": "--seed-color-bg-disabled",               "usage": "비활성 배경" }
  },

  "bg-status": {
    "_note": "Background Status — 상태색 배경. CSS: --seed-color-bg-{status}-*",

    "positive-solid":  { "Light": { "alias": "palette/green-700"  }, "Dark": "#1B5E20", "css": "--seed-color-bg-positive-solid",  "usage": "성공 배경" },
    "critical-solid":  { "Light": { "alias": "palette/red-700"    }, "Dark": "#7F0000", "css": "--seed-color-bg-critical-solid",  "usage": "에러 배경" },
    "warning-solid":   { "Light": { "alias": "palette/yellow-700" }, "Dark": "#E65100", "css": "--seed-color-bg-warning-solid",   "usage": "경고 배경" },
    "informative-solid":{ "Light": { "alias": "palette/blue-700" }, "Dark": "#0D47A1", "css": "--seed-color-bg-informative-solid","usage": "정보 배경" },
    "overlay":         { "Light": "rgba(0,0,0,0.52)", "Dark": "rgba(0,0,0,0.72)",       "css": "--seed-color-bg-overlay",         "usage": "모달 Dimmer" }
  },

  "stroke": {
    "_note": "Stroke — 테두리·구분선. CSS: --seed-color-stroke-*",

    "neutral-subtle":   { "Light": "rgba(0,0,0,0.08)", "Dark": "rgba(255,255,255,0.08)", "css": "--seed-color-stroke-neutral-subtle",   "usage": "구분선 (얇은)" },
    "neutral-muted":    { "Light": "rgba(0,0,0,0.12)", "Dark": "rgba(255,255,255,0.12)", "css": "--seed-color-stroke-neutral-muted",    "usage": "구분선 (중간)" },
    "neutral-solid":    { "Light": { "alias": "palette/gray-800"  }, "Dark": { "alias": "palette/gray-200"  }, "css": "--seed-color-stroke-neutral-solid",    "usage": "강한 테두리" },
    "neutral-contrast": { "Light": { "alias": "palette/gray-1000" }, "Dark": { "alias": "palette/gray-00"   }, "css": "--seed-color-stroke-neutral-contrast",  "usage": "가장 강한 테두리" },
    "brand-solid":      { "Light": { "alias": "palette/carrot-700" }, "Dark": { "alias": "palette/carrot-500" }, "css": "--seed-color-stroke-brand-solid",    "usage": "브랜드 테두리" },
    "critical-solid":   { "Light": { "alias": "palette/red-700"   }, "Dark": { "alias": "palette/red-700"   }, "css": "--seed-color-stroke-critical-solid",   "usage": "에러 테두리" },
    "focus-ring":       { "Light": "#1565C0",                         "Dark": "#42A5F5",                         "css": "--seed-color-stroke-focus-ring",       "usage": "포커스 링 (접근성)" }
  }
}
